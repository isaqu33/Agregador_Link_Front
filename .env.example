# Copy to .env for local Docker/dev
WEB_PORT_HOST=3071

# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Base URL of the browser-facing app (Auth.js)
AUTH_URL=http://localhost:3071
AUTH_TRUST_HOST=true

# API reached from the Next.js server. Inside Docker it is the api container.
API_INTERNAL_URL=http://agregador-api-dev:3000
