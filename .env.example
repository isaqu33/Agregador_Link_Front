# Copy to .env for local Docker/dev
WEB_PORT_HOST=3071

# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Base URL of the browser-facing app (Auth.js)
AUTH_URL=http://localhost:3071
AUTH_TRUST_HOST=true

# API reached from the Next.js server. Inside Docker it is the api container.
API_INTERNAL_URL=http://agregador-api-dev:3000

# Login with Google (optional). Create an OAuth client in Google Cloud Console (type "Web") with the redirect URI
#   http://localhost:3071/api/auth/callback/google
# and set the three variables below. OAUTH_SHARED_SECRET must equal the API's OAUTH_SHARED_SECRET.
# Leave them empty and the "Continuar com Google" button does not appear.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
OAUTH_SHARED_SECRET=
